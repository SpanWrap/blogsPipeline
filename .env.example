# Blog Pipeline environment

# Storage: file (default) or mongodb
STORAGE_BACKEND=file
PIPELINE_DATA_DIR=.data
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=spanwrap_pipeline
# MONGODB_COLLECTION=pipeline_runs

# Small review UI
UI_HOST=127.0.0.1
UI_PORT=8787

# Hot topics (public social/dev feeds)
TRENDS_SOURCES=hackernews,reddit,devto
TRENDS_REDDIT_SUBREDDITS=technology,programming,MachineLearning,startups,saas,artificial
TRENDS_LIMIT=12
TRENDS_CACHE_TTL_MINUTES=60

# Research (optional — mock used when unset)
RESEARCH_PROVIDER=auto
# SERPER_API_KEY=
# TAVILY_API_KEY=

# LLM — Groq (used for analysis, outline, generation)
# Get a key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_API_KEY=   # optional alias for GROQ_API_KEY
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Other solid Groq options: llama-3.1-8b-instant (faster/cheaper),
# meta-llama/llama-4-scout-17b-16e-instruct (if available on your plan)

# Spanwrap publish target
SPANWRAP_API_URL=http://localhost:4000
# SPANWRAP_API_KEY=
SPANWRAP_BLOGS_PATH=/api/blogs
# PUBLISHER=mock

# Networking
REQUEST_TIMEOUT_MS=30000
MAX_SOURCES=8
MAX_FETCH_CONCURRENCY=2
RESPECT_ROBOTS_TXT=true
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
