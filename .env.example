# Blog Pipeline environment
# Vercel: copy values from .env.vercel.example into the Vercel dashboard.
# Do not commit real secrets.

# Storage: file | mongodb | s3
# On Vercel, `file` is coerced to mongodb (ephemeral disk). Prefer s3 or mongodb.
STORAGE_BACKEND=s3
PIPELINE_DATA_DIR=.data
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=spanwrap_pipeline
# MONGODB_COLLECTION=pipeline_runs

# AWS S3 (when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pipeline-spanwrap
AWS_REGION=eu-north-1
# Optional key prefix inside the bucket
AWS_S3_PREFIX=pipeline
# Optional public CDN/base for image objects (no trailing slash). When set, publish
# uses these URLs instead of https://pipeline.spanwrap.com/api/runs/.../images/...
# AWS_S3_PUBLIC_BASE_URL=https://pipeline-spanwrap.s3.eu-north-1.amazonaws.com/pipeline
# AUTH_SECRET is required with S3 (no local auth-secret file)
# AUTH_SECRET=

# Public origin of this pipeline (no trailing slash). Used when publishing so
# featured/section images are absolute https URLs other platforms can fetch.
# PIPELINE_PUBLIC_URL=https://pipeline.spanwrap.com

# Review UI login (Auth.js / NextAuth). Optional seed; first visit can also create the admin account.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me-now
# AUTH_SECRET=generate-a-long-random-string   # openssl rand -hex 32
# AUTH_URL=http://localhost:3000              # optional; trustHost is enabled
# AUTH_SESSION_DAYS=7

# Small review UI
UI_HOST=127.0.0.1
UI_PORT=8787

# Hot topics (public social/dev feeds)
TRENDS_SOURCES=hackernews,reddit,devto,github
TRENDS_REDDIT_SUBREDDITS=technology,programming,MachineLearning,startups,saas,artificial
TRENDS_DIGEST_REDDIT_SUBREDDITS=artificial,MachineLearning,LocalLLaMA,OpenAI,ChatGPT,LanguageTechnology
TRENDS_GITHUB_TOPICS=ai,machine-learning,llm,generative-ai,deep-learning
TRENDS_DIGEST_LIMIT=8
TRENDS_LIMIT=12
TRENDS_CACHE_TTL_MINUTES=60
# Optional: higher GitHub Search rate limit (5000/hr vs 60/hr)
# GITHUB_TOKEN=
# TRENDS_GITHUB_SOURCE=trending
# TRENDS_GITHUB_DAYS=7
# TRENDS_GITHUB_LANGUAGE=
# Reddit OAuth (script app at https://www.reddit.com/prefs/apps) — required for reliable /top
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Official X/Twitter API v2 (required for daily X posts — no scraping)
# X_BEARER_TOKEN=

# Research (optional — mock used when unset)
RESEARCH_PROVIDER=auto
# SERPER_API_KEY=
# TAVILY_API_KEY=

# ── LLM (content generation) ──────────────────────────────────────
# Supported: groq, openai, gemini, anthropic, deepseek, mock
# Or set a provider + key in the review UI.
LLM_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_API_KEY=   # optional alias
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Prompt token budget (smaller = cheaper/faster LLM calls; larger = more depth)
# LLM_PROMPT_MAX_SOURCES=6
# LLM_PROMPT_ANALYSIS_SOURCE_CHARS=2200
# LLM_PROMPT_GENERATION_SOURCE_CHARS=2000
# LLM_PROMPT_MAX_CLAIMS=22
# LLM_PROMPT_MAX_KEY_POINTS=6
# LLM_PROMPT_MAX_TEMPLATE_CHARS=2500
# LLM_REQUEST_TIMEOUT_MS=180000

# ── Image generation (Gemini) ─────────────────────────────────────
# Uses GEMINI_API_KEY or GOOGLE_API_KEY. Falls back to mock if unset.
IMAGE_PROVIDER=auto
# Optional override (default tries gemini-3.1-flash-image, then older fallbacks)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# IMAGE_OUTPUT_DIR=.data/images
# IMAGE_MAX_SECTION_IMAGES=3

# ── Publishing targets ─────────────────────────────────────────────
# Spanwrap (primary)
SPANWRAP_API_URL=http://localhost:4000
# SPANWRAP_API_KEY=
SPANWRAP_BLOGS_PATH=/api/blogs

# Medium (https://medium.com/me/settings/security → Integration tokens)
# MEDIUM_TOKEN=
# MEDIUM_CANONICAL_BASE=https://yourblog.com/blog

# Dev.to (https://dev.to/settings/extensions → API Keys)
# DEVTO_API_KEY=
# DEVTO_CANONICAL_BASE=https://yourblog.com/blog

# Hashnode (https://hashnode.com/settings/developer)
# HASHNODE_TOKEN=
# HASHNODE_PUBLICATION_ID=
# HASHNODE_CANONICAL_BASE=https://yourblog.com/blog

# WordPress (Settings → App Passwords)
# WORDPRESS_URL=https://yoursite.com
# WORDPRESS_USER=admin
# WORDPRESS_APP_PASSWORD=

# Substack (no API — exports HTML to .data/substack-drafts/)
# SUBSTACK_DRAFTS_DIR=.data/substack-drafts

# ── Social promotion (after publish) ──────────────────────────────
BLOG_BASE_URL=https://spanwrap.com/blog
AUTO_PROMOTE_AFTER_PUBLISH=false
# X/Twitter API v2 (write access)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# LinkedIn
# LINKEDIN_ACCESS_TOKEN=
# Reddit (uses existing REDDIT_CLIENT_ID + REDDIT_CLIENT_SECRET)
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# ── SEO ────────────────────────────────────────────────────────────
# SEO_KEYWORD_DENSITY_PCT=2
# SEO_MIN_TITLE_LENGTH=50
# SEO_MAX_TITLE_LENGTH=60
# SEO_MIN_DESC_LENGTH=150
# SEO_MAX_DESC_LENGTH=160

# ── Quality / auto-accept ─────────────────────────────────────────
# AUTO_ACCEPT_ENABLED=false
# AUTO_ACCEPT_MIN_SCORE=80

# Quick Edit uses Groq (llama-3.1-8b-instant) when GROQ_API_KEY is set for speed.
# LLM_QUICK_EDIT_FAST=true
# LLM_QUICK_EDIT_MODEL=llama-3.1-8b-instant

# ── Analytics ──────────────────────────────────────────────────────
# ANALYTICS_DATA_DIR=.data/analytics
# ANALYTICS_UPDATE_INTERVAL_MINUTES=360

# ── Autopilot (weekly automated pipeline) ─────────────────────────
# Master switch — set to true to enable weekly automated blog generation
AUTOPILOT_ENABLED=false
# Cron expression (5-field, UTC). Default: every Monday at 08:00 UTC
# AUTOPILOT_CRON=0 8 * * 1
# Number of unique posts to generate per platform per cycle
# AUTOPILOT_POSTS_PER_PLATFORM=2
# Comma-separated target platforms (all 6 by default)
# AUTOPILOT_PLATFORMS=spanwrap,medium,devto,hashnode,wordpress,substack
# When true, auto-approve + publish posts that pass quality threshold
# AUTOPILOT_SKIP_REVIEW=false
# Minimum quality score for auto-approve (only when AUTOPILOT_SKIP_REVIEW=true)
# AUTOPILOT_MIN_QUALITY_SCORE=75
# Prevent re-covering topics published within this window (days)
# AUTOPILOT_DEDUP_DAYS=30
# Generate hero/section images during autopilot cycles
# AUTOPILOT_GENERATE_IMAGES=true
# Pin a specific template for all autopilot runs
# AUTOPILOT_TEMPLATE_ID=
# Generate drafts but don't publish (testing mode)
# AUTOPILOT_DRY_RUN=false

# ── Brevo email (Autopilot draft notifications) ───────────────────
# https://app.brevo.com → SMTP & API → API keys
# BREVO_API_KEY=
# Verified sender in Brevo
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=Spanwrap Pipeline
# Optional master switch (default true when key+sender set)
# BREVO_NOTIFY_ENABLED=true
# Optional default recipients (comma-separated). Prefer Settings → Email.
# BREVO_NOTIFY_TO=editor@yourdomain.com

# ── Networking ─────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
MAX_SOURCES=8
MAX_FETCH_CONCURRENCY=2
RESPECT_ROBOTS_TXT=true
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500

