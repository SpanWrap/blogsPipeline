{
  "name": "spanwrap-blog-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone blog research and generation pipeline that publishes approved posts to Spanwrap via HTTP",
  "type": "module",
  "main": "server.ts",
  "bin": {
    "blog-pipeline": "./src/cli/index.ts"
  },
  "scripts": {
    "pipeline": "tsx src/cli/index.ts",
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server.js && cp -R public dist/public",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0",
    "robots-parser": "^3.0.1",
    "sanitize-html": "^2.17.5",
    "slugify": "^1.6.9",
    "tsx": "^4.23.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
