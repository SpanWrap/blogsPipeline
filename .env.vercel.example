# Paste these into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Do not commit real secrets.
#
# Atlas: Database Access user + Network Access 0.0.0.0/0 (Vercel has no fixed IP).

STORAGE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=spanwrap_pipeline
MONGODB_COLLECTION=pipeline_runs

LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

RESEARCH_PROVIDER=auto
# SERPER_API_KEY=
# TAVILY_API_KEY=

SPANWRAP_API_URL=https://your-spanwrap-site.example
SPANWRAP_API_KEY=
SPANWRAP_BLOGS_PATH=/api/blogs

TRENDS_SOURCES=hackernews,reddit,devto,github
TRENDS_REDDIT_SUBREDDITS=technology,programming,MachineLearning,startups,saas,artificial
TRENDS_DIGEST_REDDIT_SUBREDDITS=artificial,MachineLearning,LocalLLaMA,OpenAI,ChatGPT,LanguageTechnology
TRENDS_GITHUB_TOPICS=ai,machine-learning,llm,generative-ai,deep-learning
TRENDS_DIGEST_LIMIT=8
TRENDS_LIMIT=12
TRENDS_CACHE_TTL_MINUTES=60
# GITHUB_TOKEN=
# TRENDS_GITHUB_SOURCE=search
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# X_BEARER_TOKEN=

# Review UI login (required on Vercel). Auth.js / NextAuth — openssl rand -hex 32
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=
AUTH_SESSION_DAYS=7

# Weekly autopilot. Vercel Cron calls GET /api/cron/autopilot (Monday 08:00 UTC).
# Vercel injects CRON_SECRET automatically; do not paste it here.
AUTOPILOT_ENABLED=false
# AUTOPILOT_CRON=0 8 * * 1
# AUTOPILOT_SKIP_REVIEW=false

REQUEST_TIMEOUT_MS=60000
MAX_SOURCES=8
MAX_FETCH_CONCURRENCY=2
RESPECT_ROBOTS_TXT=true
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
