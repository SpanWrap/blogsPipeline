# Paste these into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Do not commit real secrets.
#
# Atlas: Database Access user + Network Access 0.0.0.0/0 (Vercel has no fixed IP).

STORAGE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=spanwrap_pipeline
MONGODB_COLLECTION=pipeline_runs

LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

RESEARCH_PROVIDER=auto
# SERPER_API_KEY=
# TAVILY_API_KEY=

SPANWRAP_API_URL=https://your-spanwrap-site.example
SPANWRAP_API_KEY=
SPANWRAP_BLOGS_PATH=/api/blogs

TRENDS_SOURCES=hackernews,reddit,devto
TRENDS_REDDIT_SUBREDDITS=technology,programming,MachineLearning,startups,saas,artificial
TRENDS_LIMIT=12
TRENDS_CACHE_TTL_MINUTES=60

REQUEST_TIMEOUT_MS=60000
MAX_SOURCES=8
MAX_FETCH_CONCURRENCY=2
RESPECT_ROBOTS_TXT=true
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
